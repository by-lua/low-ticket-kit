# Node / Coolify (node server.mjs). Export these variables in the shell or in the Coolify service settings. Test keys only:
# the server refuses sk_live unless ALLOW_LIVE=1 (only with the owner's order).
PORT=4242
PUBLIC_URL=https://pay.example.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_<secret>
PAYPAL_CLIENT_ID=...
PAYPAL_SECRET=...
# PAYPAL_ENV=live   # production only
DATA_DIR=/data      # persistent volume on Coolify
# Delivery to the offer's members area (route on the offer site; see AGENTS.md §1c). Empty = only logs.
DELIVERY_WEBHOOK_URL=https://site.example.com/api/checkout-delivery
DELIVERY_WEBHOOK_SECRET=change-me-long-random
# Trackeador mirror: connection with gateway "generic" + the secret printed when it was created.
TRACKEADOR_WEBHOOK_URL=https://<trackeador-host>/api/webhooks/sale/c/<connection_id>
TRACKEADOR_SECRET=...
# Enables POST /api/admin/resend?id=<order> (re-send delivery + Trackeador). Empty = disabled.
ADMIN_TOKEN=change-me-long-random
